# ---- Databricks (unica dipendenza esterna) ----
DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
DATABRICKS_TOKEN=<personal access token>
LLM_ENDPOINT_NAME=databricks-gpt-oss-20b
EMBEDDING_ENDPOINT_NAME=databricks-qwen3-embedding-0-6b

# ---- Storage/retrieval native (Unity Catalog + Vector Search + SQL Warehouse) ----
UC_CATALOG=workspace
UC_SCHEMA=airbnb
VS_ENDPOINT=airbnb-vs
VS_INDEX=workspace.airbnb.review_chunks_index
SQL_WAREHOUSE_ID=<warehouse id, es. da `databricks warehouses list`>


# ---- Reranker locale (CrossEncoder, MPS) ----
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_DEVICE=mps

# ---- Runtime ----
CACHE_TTL_SECONDS=300
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
RETRIEVAL_TOP_K=20
RERANK_TOP_K=3
